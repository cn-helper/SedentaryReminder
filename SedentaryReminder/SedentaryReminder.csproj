<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
<!--    <OutputType>WinExe</OutputType>-->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
<!--    <TargetFramework>net8.0-windows7.0</TargetFramework>-->
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
    <ApplicationIcon>Resources\favicon.ico</ApplicationIcon>
    <Company>helper.top</Company>
    <Product>久坐休息提醒</Product>
    <!-- 版本号设计:
         VERSION 文件 = 完整四段版本号 (如 1.1.9.93), REVISION 可非零, 是 UI 显示版本的基础.
         Store Identity Version (Package.appxmanifest) = 前三段 + ".0" (如 1.1.9.0),
           由 build_multiarch.ps1 从 VERSION 派生, Store 硬性约束第四段必须为 0.
         csproj 各字段:
           - AssemblyVersion = 前三段 (强名称绑定稳定)
           - FileVersion = yyyy.MMdd.HHmm (编译时刻)
           - Version / AssemblyInformationalVersion = 完整四段 (UI 显示基础) -->
    <!-- 单一数据源: 仓库根目录 VERSION 文件 (四段, REVISION 可非零, 如 1.1.9.93) -->
    <FullVersion>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\VERSION').Trim())</FullVersion>
    <!-- 渠道标识: 必须在版本字段之前定义, 确保 $(Channel) 求值时已有值.
         编译时 /p:Channel=<name> 注入, 默认 dev. Store 包传 store, 其他渠道传对应名称. -->
    <Channel Condition="'$(Channel)' == ''">dev</Channel>
    <!-- AssemblyVersion: 取前三段 (MAJOR.MINOR.PATCH), 保证强名称绑定稳定, REVISION 不参与, 不能带渠道后缀 -->
    <AssemblyVersion>$([System.Version]::Parse($(FullVersion)).ToString(3))</AssemblyVersion>
    <!-- FileVersion: 编译时刻 yyyy.MMdd.HHmm (如 2026.0923.1530), 仅显示用, 不影响 Store 校验, 不能带渠道后缀 -->
    <FileVersion Condition="'$(FileVersion)' == ''">$([System.DateTime]::Now.ToString('yyyy.MMdd.HHmm'))</FileVersion>
    <!-- Version: NuGet/包版本号 = 完整四段 (NuGet 不接受四段+预发布标签, 保持纯净) -->
    <Version>$(FullVersion)</Version>
    <!-- InformationalVersion / AssemblyInformationalVersion: UI 显示版本号 = 完整四段 + 渠道 (如 1.1.9.93-dev).
         SDK 实际用 InformationalVersion 生成 AssemblyInformationalVersionAttribute, 两个都设保证兼容.
         GetChannelVersion() 直接读取此值, 运行时无需再拼接渠道. -->
    <InformationalVersion>$(FullVersion)-$(Channel)</InformationalVersion>
    <AssemblyInformationalVersion>$(FullVersion)-$(Channel)</AssemblyInformationalVersion>
    <!-- ★ 必须 false, 否则 SDK 会把 git commit hash 追加到 InformationalVersion (出现 +abcdef0 尾巴) -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <BuildTime>$([System.DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ'))</BuildTime>
    <!-- 文件说明属性 -->
    <Description>久坐警报、定时休息提示、定时关机设定，助您告别久坐危害，守护眼睛和颈椎健康。您的贴心健康提醒小帮手！！！</Description>
    <AssemblyDescription>久坐警报、定时休息提示、定时关机设定，助您告别久坐危害，守护眼睛和颈椎健康。您的贴心健康提醒小帮手！！！</AssemblyDescription>
    <!-- 禁用自动生成程序集属性，避免与项目文件中定义的属性冲突 -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    
    <!-- 指定要使用的清单文件 -->
    <AppxManifest>Appx.xml</AppxManifest> <!-- 或 Package.appxmanifest -->
    <AssemblyTitle>久坐休息提醒</AssemblyTitle>
    <Copyright>Copyright © 2025 Helper.top. All rights reserved.</Copyright>

    <!-- 禁用自动生成清单 -->
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
      <TrimMode>link</TrimMode>
    <PublishReadyToRun>true</PublishReadyToRun>
      <PublisherName>Helper.top</PublisherName>
<!--      <Nullable>enable</Nullable>-->
<!--      <ImplicitUsings>enable</ImplicitUsings>-->
<!--      <ConsoleEncoding>UTF-8</ConsoleEncoding>-->
  </PropertyGroup>

  <!-- 注入渠道和编译时间到程序集元数据, 运行时由 ChannelInfoHelper 读取 -->
